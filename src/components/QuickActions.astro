<style>
  .qa-section {
    margin: 1.5rem auto 0;
    max-width: 520px;
    animation: qa-section-in 0.6s ease-out 0.3s both;
  }
  @keyframes qa-section-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .qa-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--sl-color-text-muted);
    margin-bottom: 0.65rem;
    padding-left: 0.25rem;
  }
  .qa-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .qa-btn {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.4rem;
    border-radius: 16px;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    border: 1.5px solid var(--sl-color-hairline-light);
    background: var(--sl-color-panel);
    transition: transform 0.3s cubic-bezier(.22,1,.36,1), box-shadow 0.3s ease, border-color 0.3s ease;
    opacity: 0;
    animation: qa-btn-in 0.5s ease-out forwards;
  }
  .qa-btn:nth-child(2) { animation-delay: 0.12s; }
  @keyframes qa-btn-in {
    from { opacity: 0; transform: translateX(-12px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .qa-btn-glow {
    position: absolute;
    top: -50%; left: -50%; width: 200%; height: 200%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .qa-btn:hover .qa-btn-glow { opacity: 1; }

  /* 世界地图按钮 */
  .qa-btn--map { border-color: color-mix(in srgb, #a855f7 25%, var(--sl-color-hairline-light)); }
  .qa-btn--map .qa-btn-glow {
    background: radial-gradient(circle at 30% 50%, rgba(168,85,247,0.08) 0%, transparent 60%);
  }
  .qa-btn--map .qa-btn-icon { background: rgba(168,85,247,0.12); color: #a855f7; }
  .qa-btn--map:hover {
    border-color: #a855f7;
    box-shadow: 0 4px 24px rgba(168,85,247,0.2), 0 0 0 1px rgba(168,85,247,0.1);
    transform: translateY(-2px);
  }
  .qa-btn--map:hover .qa-btn-icon { background: rgba(168,85,247,0.2); }

  /* QQ群按钮 */
  .qa-btn--qq { border-color: color-mix(in srgb, #12B7F5 25%, var(--sl-color-hairline-light)); }
  .qa-btn--qq .qa-btn-glow {
    background: radial-gradient(circle at 70% 50%, rgba(18,183,245,0.08) 0%, transparent 60%);
  }
  .qa-btn--qq .qa-btn-icon { background: rgba(18,183,245,0.12); color: #12B7F5; }
  .qa-btn--qq:hover {
    border-color: #12B7F5;
    box-shadow: 0 4px 24px rgba(18,183,245,0.2), 0 0 0 1px rgba(18,183,245,0.1);
    transform: translateY(-2px);
  }
  .qa-btn--qq:hover .qa-btn-icon { background: rgba(18,183,245,0.2); }

  .qa-btn-icon {
    width: 52px; height: 52px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(.22,1,.36,1), background 0.3s ease;
  }
  .qa-btn:hover .qa-btn-icon { transform: scale(1.1); }
  .qa-btn-text { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .qa-btn-title {
    font-size: 1rem; font-weight: 700; color: var(--sl-color-text); line-height: 1.3;
  }
  .qa-btn-desc {
    font-size: 0.8rem; color: var(--sl-color-text-muted); margin-top: 0.15rem;
  }
  .qa-arrow {
    flex-shrink: 0; color: var(--sl-color-text-muted);
    transition: transform 0.3s ease, color 0.3s ease;
  }
  .qa-btn--map:hover .qa-arrow { transform: translate(3px, -3px); color: #a855f7; }
  .qa-btn--qq:hover .qa-arrow { transform: translate(3px, -3px); color: #12B7F5; }

  @media (max-width: 480px) {
    .qa-btn { padding: 0.9rem 1rem; gap: 0.75rem; }
    .qa-btn-icon { width: 44px; height: 44px; border-radius: 12px; }
    .qa-btn-icon svg { width: 22px; height: 22px; }
    .qa-btn-title { font-size: 0.92rem; }
    .qa-arrow { display: none; }
  }
</style>
