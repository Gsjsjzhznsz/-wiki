      <div class="qa-btn-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 13.2c-.18.28-.56.37-.84.2-2.3-1.4-5.2-1.72-8.62-.94-.34.08-.66-.14-.74-.46-.08-.34.14-.66.46-.74 3.72-.84 6.92-.48 9.54 1.12.28.16.36.56.2.82zm1.24-2.7c-.22.34-.68.46-1.02.24-2.64-1.62-6.66-2.1-9.78-1.14-.4.12-.82-.1-.94-.5-.12-.4.1-.82.5-.94 3.52-1.08 7.96-.54 10.98 1.32.34.2.44.66.26 1.02zm.1-2.82c-3.16-1.88-8.36-2.04-11.38-1.14-.48.14-.98-.12-1.12-.6-.14-.48.12-.98.6-1.12 3.48-1.06 9.16-.88 12.78 1.26.44.26.58.82.32 1.26-.26.42-.82.58-1.2.3z"/>
